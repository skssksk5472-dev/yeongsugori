# 복사해서 .env 로 쓴다. .env 는 깃에 올리지 않는다.
# MongoDB Atlas 연결 주소 (Atlas 화면 Connect > Drivers 에서 복사, <password> 를 실제 비밀번호로 바꾼다)
# 예: mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority
# 비워 두면 이 PC의 mongo 를 쓴다 (docker: docker compose --profile local-db up, 개발: localhost:27017)
MONGODB_URI=
# DB 이름은 주소가 아니라 여기서 정한다
MONGODB_DB=zalssm
# 로그인 토큰(JWT) 서명 키. 길고 임의의 문자열로 채운다. 비워 두면 서버가 시작하지 않는다
JWT_SECRET_KEY=
JWT_EXPIRE_DAYS=7
COOKIE_SECURE=false
# 영수증 이미지 폴더. 비워 두면 docker는 /data/uploads(볼륨), 개발 서버는 back/uploads 를 쓴다
UPLOAD_DIR=
MAX_UPLOAD_MB=10
# mock | openai
OCR_MODE=mock
# ok | mismatch | not_receipt | timeout (mock일 때만)
OCR_MOCK_SCENARIO=ok
# OCR_MODE=openai 일 때만 쓴다. 키는 이 파일(.env)에만 둔다
OPENAI_API_KEY=
# 비워 두면 gpt-6-luna (이미지 입력·JSON 스키마 출력을 지원하는 가장 저렴한 모델, 2026-11 기준)
OPENAI_MODEL=
OCR_TIMEOUT_SEC=30
SCAN_LIMIT_PER_HOUR=20
NEXT_PUBLIC_APP_VERSION=1.0.0
